# Copy to .env for local dev (edgeone pages dev). Never commit .env.
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-2.5-flash
# Optional: lock the endpoint to your site
# ALLOWED_ORIGIN=https://your-project.edgeone.app
# Short share codes (optional). Use Upstash Redis, or bind an EdgeOne KV namespace as TALLY_KV.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token
# SHARE_TTL_DAYS=90
